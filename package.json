{
  "name": "wheeldeal",
  "version": "1.0.0",
  "private": true,
  "description": "WheelDeal \u2014 hyper-local vehicle rental savings & negotiation engine",
  "workspaces": [
    "packages/*",
    "apps/gateway",
    "services/workers"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "typecheck:services": "tsc --noEmit -p apps/gateway && tsc --noEmit -p services/workers",
    "test": "vitest run",
    "test:e2e": "TEST_REDIS_URL=${TEST_REDIS_URL:-redis://127.0.0.1:6399} vitest run packages/testing/e2e.test.ts",
    "gateway": "tsx --tsconfig apps/gateway/tsconfig.json apps/gateway/src/server.ts",
    "workers": "tsx --tsconfig services/workers/tsconfig.json services/workers/src/index.ts",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "check:mobile": "node scripts/mobile-check.mjs",
    "test:browser": "playwright test",
    "knip": "knip",
    "check:cookies": "node scripts/cookie-gate-check.mjs",
    "check:traffic": "node scripts/traffic-check.mjs",
    "db:local": "./tooling/dev/local-db.sh",
    "sim": "node tooling/sim/evolution-sim.mjs",
    "dev:sim": "node tooling/dev/dev-sim.mjs",
    "drive": "node tooling/dev/live-drive.mjs"
  },
  "dependencies": {
    "@paypal/react-paypal-js": "^10.1.2",
    "@tanstack/react-virtual": "^3.14.9",
    "bullmq": "^5.80.9",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "leaflet": "^1.9.4",
    "next": "^14.2.35",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "tsx": "^4.23.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.19",
    "knip": "^5.88.1",
    "playwright": "^1.62.1",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
