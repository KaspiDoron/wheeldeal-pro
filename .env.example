# =============================================================================
# WheelDeal - environment configuration
# =============================================================================
# Copy this file to `.env.local` for local dev, or paste these into your host's
# dashboard (GCP Secret Manager) for production.
#
# The app runs fully in DEMO MODE with none of these set (in-memory data +
# deterministic mock AI). Add keys to switch on the real integrations.
#
# SECURITY: never commit a filled-in copy of this file. `.env*` is gitignored.
# The four tokens shared in chat should be rotated before use - treat them as
# compromised the moment they left a private channel.
# =============================================================================

# ---- LLM providers (server-side only; the app picks the first one present) ---
GEMINI_TOKEN=
# GROQ_TOKEN also powers voice-note transcription (whisper-large-v3, accent-primed)
GROQ_TOKEN=
OPENROUTER_TOKEN=
CEREBRAS_TOKEN=

# Which provider to prefer when several keys are set: groq | gemini | openrouter | cerebras
AI_PROVIDER=groq

# Digraph negotiation engine (v2) is ON by default. Set to "off" to fall back to
# the legacy inline reply pipeline for one release. (Editable in Admin -> Keys.)
GRAPH_ENGINE=

# ---- Supabase (bootstrap - enables durable data + a persistent admin Key Vault)
# With these set, keys pasted in the admin panel are encrypted and saved to
# Supabase (survive serverless restarts). Without them, the app runs in demo
# mode and admin edits apply to the current instance only. Run supabase/schema.sql
# once in the SQL editor. SUPABASE_URL and NEXT_PUBLIC_SUPABASE_URL are
# interchangeable server-side; the service role key must stay server-only.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- WhatsApp Cloud API (official Meta Graph API - optional) -----------------
# Can be set here OR pasted later in the admin Key Vault. Leave blank to use
# compliant click-to-chat (wa.me) links instead of the Cloud API.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Any string you choose; enter the same value in Meta's webhook config.
WHATSAPP_VERIFY_TOKEN=

# ---- Auth / access control ---------------------------------------------------
# The single owner account (full control, AI co-manager access).
OWNER_EMAIL=kaspidoron@gmail.com
# Comma-separated management allowlist (the owner is always included).
ADMIN_EMAILS=kaspidoron@gmail.com
# One-time bootstrap secret for the owner's FIRST sign-in on a fresh database
# (8+ characters, NO default). The app forces a password change on that first
# login, after which this can be removed. Unset = the owner bootstrap is
# refused with 503 rather than minting a well-known credential.
OWNER_BOOTSTRAP_PASSWORD=
# Secret used to sign session cookies. Generate: openssl rand -hex 32
SESSION_SECRET=change-me-in-production-please-use-a-32-byte-random-hex
# OPTIONAL rotation salt for the Evolution webhook / cron-tick token. The token
# is normally derived from SESSION_SECRET alone - which cannot be rotated
# freely because it also encrypts the Key Vault. Setting (or changing) this
# rotates every webhook token at once; the fleet re-arms itself on the next
# ping cycle. Leave empty unless you are rotating a leaked token.
WEBHOOK_TOKEN_SALT=

# ---- Google (optional - can also be pasted in Admin -> Keys) -------------------
# Maps/Places/Geocoding server key: real vendors, precise addresses, reviews.
GOOGLE_MAPS_API_KEY=
# OAuth 2.0 Web client ID for "Continue with Google" sign-in.
GOOGLE_OAUTH_CLIENT_ID=

# ---- Payments (PayPal Subscriptions) --------------------------------------------
# PayPal has no merchant-approval gate, is free to set up ($0/month), and pays
# out to Israeli bank accounts. Create a REST app for the CLIENT_ID/SECRET, two
# Billing Plans (Pro + Ultra) for the PLAN ids, and a Webhook for the WEBHOOK_ID.
# All of these can also be pasted later in Admin -> Keys. See GUIDE.md.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PLAN_PRO=
PAYPAL_PLAN_ULTRA=
PAYPAL_WEBHOOK_ID=
# "live" (default) or "sandbox" for testing with PayPal sandbox accounts.
PAYPAL_ENV=live
# Optional: bake the public client id in at build time instead of Admin -> Keys.
# The SECRET is server-only and must NEVER be prefixed NEXT_PUBLIC_.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# ---- Personal WhatsApp connector (Evolution API, self-hosted, free) ------------
# Users scan a QR in Profile to bargain from their OWN number. Deploy Evolution
# API (see GUIDE.md), then set its URL + the AUTHENTICATION_API_KEY you chose.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# ---- Google AdSense (free-tier ads; paid plans are ad-free) ---------------------
# OPTIONAL. The site's own publisher id (ca-pub-4965894186804157) is a public
# constant in src/lib/site.ts, so the site tag, the account meta tag, ads.txt
# and the ad slots all work with nothing set here. Set this ONLY to point the
# app at a different AdSense account.
ADSENSE_CLIENT=

# ---- Email (optional - feedback also lands in the in-app Admin inbox) ----------
RESEND_API_KEY=
FEEDBACK_FROM_EMAIL=

